   "source": [
    "import os, sys\n",
    "p = os.getcwd()\n",
    "while p != os.path.dirname(p) and not (os.path.isdir(os.path.join(p, \"model\")) and os.path.isdir(os.path.join(p, \"action\"))):\n",
    "    p = os.path.dirname(p)\n",
    "os.chdir(p); sys.path.insert(0, p)\n",
    "%run dashboard/build_dashboard.py"
   ]
  }
